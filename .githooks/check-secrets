#!/bin/sh
# Refuses a commit that would publish a secret. This repository is public, so
# anything committed here is readable by everyone, forever (history included).
#
# It blocks three things in the staged changes:
#   1. any tracked file that .gitignore says must not be uploaded (a forced
#      `git add -f`, or a file that was tracked before its ignore rule existed);
#   2. a staged file whose name is a key or credential (.env, .p8, .p12, ...);
#   3. a staged line that contains a private key or a key-shaped token.
#
# A false alarm can be let through once with `git commit --no-verify`, but
# read what it flagged first.

fail=0

# 1. Staged files that the ignore rules cover.
ignored=$(git ls-files -ci --exclude-standard)
if [ -n "$ignored" ]; then
  echo "check-secrets: .gitignore says these must not be uploaded, but they are tracked:"
  printf '%s\n' "$ignored" | sed 's/^/    /'
  echo "    (stop tracking one with: git rm --cached <file>)"
  fail=1
fi

# 2. Key and credential file names.
names=$(git diff --cached --name-only --diff-filter=ACMR | grep -iE \
  '(^|/)\.env($|\.)|\.p8$|\.p12$|\.pfx$|\.pem$|\.key$|\.keystore$|\.mobileprovision$|\.provisionprofile$|(^|/)id_(rsa|dsa|ecdsa|ed25519)|(^|/)AuthKey_|(^|/)\.netrc$|(^|/)\.npmrc$' \
  | grep -vE '(^|/)\.env\.example$')
if [ -n "$names" ]; then
  echo "check-secrets: these staged files look like keys or credentials:"
  printf '%s\n' "$names" | sed 's/^/    /'
  fail=1
fi

# 3. Key-shaped text in added lines. Only patterns with a recognizable shape are
#    listed, so the Cloudflare analytics token (public by design) passes.
pattern='BEGIN [A-Z ]*PRIVATE KEY|sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|[sr]k_(live|test)_[A-Za-z0-9]{16,}|whsec_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[A-Za-z0-9-]{10,}|re_[A-Za-z0-9]{8}_[A-Za-z0-9]{20,}|hf_[A-Za-z0-9]{30,}|SG\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|eyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{10,}'
hits=$(git diff --cached --no-color -U0 --diff-filter=ACMR \
  | grep -E '^(\+\+\+ |\+)' \
  | awk -v pat="$pattern" '
      /^\+\+\+ / { file = substr($0, 7); next }
      $0 ~ pat   { print "    " file ": " substr($0, 2, 28) "..." }')
if [ -n "$hits" ]; then
  echo "check-secrets: these added lines look like a private key or an API key:"
  printf '%s\n' "$hits"
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "check-secrets: commit stopped. Remove the secret (and rotate it if it was ever pushed)."
  exit 1
fi
exit 0
